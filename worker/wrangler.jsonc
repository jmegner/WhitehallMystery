{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "whitehall-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://jmegner.github.io,https://whitehallmystery.pages.dev",
    "ROOM_TTL_DAYS": "45"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "SESSION_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "CREATE_GAME_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CONNECT_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
