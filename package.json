{
  "name": "whitehallmystery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "generate:map-data": "node scripts/generate-map-data.mjs",
    "check:map-data": "node scripts/generate-map-data.mjs --check",
    "build": "npm run check:map-data && npm run typecheck:worker && npm run build:worker && tsc -b && vite build",
    "build:gh": "npm run check:map-data && npm run typecheck:worker && npm run build:worker && tsc -b && vite build --base=/WhitehallMystery/",
    "build:cf": "npm run build",
    "build:worker": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir worker/dist",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run src worker",
    "test:e2e": "playwright test --grep-invert \"online departures\" && playwright test tests/e2e/onlineDepartures.spec.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
